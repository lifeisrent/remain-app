# ─────────────────────────────────────
# Remain Server — Environment Variables
# ─────────────────────────────────────
# Copy this file to .env and fill in your values

# Anthropic API Key (required)
# Get one at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_api_key_here

# Bind host for LAN access
# - localhost only: 127.0.0.1
# - local network: 0.0.0.0
HOST=0.0.0.0

# Port the server listens on (default: 3001)
PORT=3001

# Frontend URL(s) for CORS (comma-separated)
# ex) CLIENT_URLS=http://localhost:5173,http://192.168.0.10:5173
CLIENT_URLS=http://localhost:5173
