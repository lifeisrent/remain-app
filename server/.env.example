# ─────────────────────────────────────
# Remain Server — Environment Variables
# ─────────────────────────────────────
# Copy this file to .env and fill in your values

# Anthropic API Key (required)
# Get one at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_api_key_here

# Bind host for LAN access
# - localhost only: 127.0.0.1
# - local network: 0.0.0.0
HOST=0.0.0.0

# Port the server listens on (default: 3001)
PORT=3001

# Frontend URL(s) for CORS (comma-separated)
# ex) CLIENT_URLS=http://localhost:5173,http://192.168.0.10:5173
CLIENT_URLS=http://localhost:5173

# Whisper / STT provider (local | openai)
WHISPER_PROVIDER=local

# Local whisper-compatible endpoint (used when WHISPER_PROVIDER=local)
# Example for local/faster-whisper HTTP server
WHISPER_LOCAL_URL=http://127.0.0.1:9000/v1/audio/transcriptions
WHISPER_LOCAL_MODEL=whisper-1
# Optional bearer token for local endpoint
WHISPER_LOCAL_AUTH_BEARER=

# OpenAI fallback (used when WHISPER_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_URL=https://api.openai.com/v1/audio/transcriptions
OPENAI_WHISPER_MODEL=whisper-1
